# Discover bibliography files beside the main document on each latexmk run.
# Prefer biblio.bib; otherwise use every .bib file, in alphabetical order.
# With no files, the bibliography list is empty.
use File::Glob qw(bsd_glob);
my @project_bibs = sort grep { -f $_ } bsd_glob('*.bib');
@project_bibs = ('biblio.bib') if grep { $_ eq 'biblio.bib' } @project_bibs;
my $bib_list = join(',', @project_bibs);
my $bib_config = 'auto-bibliography.tex';
my $bib_content = "% Generated by latexmkrc; do not edit.\n"
    . '\\def\\PreambleBibliographyFiles{\\detokenize{' . $bib_list . "}}\n";
# An empty list must expand to an empty macro for the LaTeX guard.
$bib_content = "% Generated by latexmkrc; do not edit.\n"
    . "\\def\\PreambleBibliographyFiles{}\n" unless @project_bibs;

# Preserve the timestamp when unchanged, so latexmk can stay up to date.
my $old_bib_content = '';
if (open my $bib_read, '<', $bib_config) {
    local $/;
    $old_bib_content = <$bib_read>;
    close $bib_read;
}
if ($old_bib_content ne $bib_content) {
    open my $bib_write, '>', $bib_config or die "Cannot write $bib_config: $!";
    print {$bib_write} $bib_content;
    close $bib_write or die "Cannot close $bib_config: $!";
}
