+/** Measurement only: first failing clause of the ordered rule, in the order passesLondonOrderedRules tests them. */
+function rsOrderedRuleFailure(rawHand: readonly CastabilityCard[], config: LondonCurvePolicyConfig): string | null {
+  const hand = flexibleKeepView(rawHand, config.idealLandCount);
+  const lands = hand.filter((card): card is LandCard => card.kind === "land");
+  const spells = hand.filter((card): card is SpellCard => card.kind === "spell");
+  const modeledSpells = spells.filter((spell) => spell.simulationRole !== "inert");
+  const landCount = lands.length;
+  const [, maxKeepLands] = config.suggestedLandWindow;
+  const floors = effectiveLondonFloors(hand.length, config);
+  const maxHandManaValue = Math.max(0, ...modeledSpells.map(manaValue));
+  if (landCount === 0) return "noLands";
+  if (landCount < floors.minLandFloor || landCount < floors.minKeepLands) return "belowLandFloor";
+  if (spells.length < floors.minNonlandFloor) return "belowNonlandFloor";
+  if (landCount > maxKeepLands) return "aboveLandWindow";
+  const curveJustifiedLandCount = Math.max(floors.minLandFloor, maxHandManaValue + 1);
+  if (landCount >= maxKeepLands && landCount > curveJustifiedLandCount + 1) return "softFlood";
+  return null;
+}
+
+function rsRecordMulliganAttempt(
+  attempt: number,
+  keptHand: readonly CastabilityCard[],
+  config: LondonCurvePolicyConfig,
+  rulesOk: boolean,
+  scoreOk: boolean
+): void {
+  const stats = (globalThis as { __ruleStats?: Record<string, number> }).__ruleStats;
+  if (stats === undefined) return;
+  const inc = (key: string): void => {
+    stats[key] = (stats[key] ?? 0) + 1;
+  };
+  const failure = rsOrderedRuleFailure(keptHand, config);
+  if ((failure === null) !== rulesOk) inc("mull.anomalyReasonMismatch");
+  inc(`mull.attempt${attempt}.hands`);
+  if (rulesOk && scoreOk) inc(`mull.attempt${attempt}.keep`);
+  else if (!rulesOk) inc(`mull.attempt${attempt}.mulliganRule.${failure}`);
+  else inc(`mull.attempt${attempt}.mulliganScoreBelowThreshold`);
+}
