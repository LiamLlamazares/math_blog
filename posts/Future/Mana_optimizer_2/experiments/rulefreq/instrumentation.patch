+// ---------------------------------------------------------------------------------------------------------------
+// RULE-FREQUENCY INSTRUMENTATION (measurement copy only). Everything below only reads state and increments counters
+// on globalThis.__ruleStats when that object exists; it never changes a simulation decision.
+// ---------------------------------------------------------------------------------------------------------------
+type RuleStatsBag = Record<string, number>;
+const rsGet = (): RuleStatsBag | undefined => (globalThis as { __ruleStats?: RuleStatsBag }).__ruleStats;
+function rsInc(key: string, by = 1): void {
+  const stats = rsGet();
+  if (stats !== undefined) {
+    stats[key] = (stats[key] ?? 0) + by;
+  }
+}
+/** Only turns 1..RS_HORIZON are counted (the scored play horizon); the simulation itself runs further. */
+const RS_HORIZON = 4;
+interface RsLandOutcome {
+  key: string;
+  entry: LandEntryOption;
+  score: LandPlayScore;
+}
+let rsLandTrace: RsLandOutcome[] | null = null;
+/** 0 = off; j in 2..6 = planTurn compares levels 1..j-1 normally and level j reversed (finds a worse alternative). */
+let rsShadowLevel = 0;
+let rsGameFlags = { lifeAny: false, lifeEntry: false, dorkCast: false, dorkRemoved: false, drawCast: false, rampCast: false };
+let rsTurnFlags = { castDecision: false, bite: false, firstBite: 0, landMulti: false, landFirstRemoval: "" };
+function rsResetGame(): void {
+  rsGameFlags = { lifeAny: false, lifeEntry: false, dorkCast: false, dorkRemoved: false, drawCast: false, rampCast: false };
+}
+function rsResetTurn(): void {
+  rsTurnFlags = { castDecision: false, bite: false, firstBite: 0, landMulti: false, landFirstRemoval: "" };
+}
+function rsFlushTurn(): void {
+  rsInc("turns");
+  if (rsTurnFlags.castDecision) rsInc("spell.turnsWithCast");
+  if (rsTurnFlags.bite) {
+    rsInc("spell.turnsWithTieBreak");
+    rsInc(`spell.turnFirstBite.L${rsTurnFlags.firstBite}`);
+  }
+  if (rsTurnFlags.landMulti) rsInc("land.turnsWithChoice");
+}
+
+const RS_LAND_LEVELS: readonly [string, (score: LandPlayScore) => number][] = [
+  ["L1_currentSupport", (s) => s.currentSupport],
+  ["L2_actualManaSpent", (s) => s.actualManaSpent],
+  ["L3_actualHighestManaValue", (s) => s.actualHighestManaValue],
+  ["L4_nextSupport", (s) => s.nextSupport],
+  ["L5_lifePaid", (s) => -s.lifePaid],
+  ["L6_actualLifePaid", (s) => -s.actualLifePaid],
+  ["L7_deckSupport", (s) => s.deckSupport],
+  ["L8_entersTapped", (s) => (s.entersTapped ? 1 : 0)]
+];
+
+function rsRecordLandDecision(trace: RsLandOutcome[] | null, chosen: LandPlayChoice | null, turn: number): void {
+  if (trace === null || chosen === null || turn > RS_HORIZON || rsGet() === undefined) {
+    return;
+  }
+  rsInc("land.decisions");
+  if (trace.some((outcome) => outcome.entry.entryLifePaid > 0)) {
+    rsInc("life.offered");
+    if (chosen.entry.entryLifePaid > 0) rsInc("life.offeredAndPaid");
+  }
+  if (trace.length <= 1) {
+    return;
+  }
+  rsTurnFlags.landMulti = true;
+  rsInc("land.multi");
+  const distinctLands = new Set(trace.map((outcome) => outcome.key)).size;
+  rsInc(distinctLands > 1 ? "land.multi.differentLands" : "land.multi.sameLandEntryOnly");
+  let remaining = trace;
+  let firstRemoval = "";
+  for (const [name, value] of RS_LAND_LEVELS) {
+    const best = Math.max(...remaining.map((outcome) => value(outcome.score)));
+    const next = remaining.filter((outcome) => value(outcome.score) === best);
+    if (next.length < remaining.length) {
+      rsInc(`land.bite.${name}`);
+      if (firstRemoval === "") firstRemoval = name;
+      if (next.length === 1) rsInc(`land.resolvedAt.${name}`);
+    }
+    remaining = next;
+  }
+  rsInc(`land.firstRemoval.${firstRemoval === "" ? "none_all_tied" : firstRemoval}`);
+  if (remaining.length > 1) rsInc("land.unresolvedAfterAllLevels");
+  if (!remaining.some((outcome) => outcome.score === chosen.score)) rsInc("land.anomalyChosenNotInFinalSet");
+}
+
+function rsBaseId(id: string): string {
+  return id.replace(/#\d+$/, "");
+}
+function rsPlanValue(plan: TurnPlan, level: number): number {
+  switch (level) {
+    case 1: return plan.manaSpent;
+    case 2: return plan.drawFilterCasts;
+    case 3: return plan.rampCasts;
+    case 4: return plan.highestManaValue;
+    case 5: return plan.lifePaid;
+    default: return 0;
+  }
+}
+/** Direction-normalised comparison of one level: positive when `left` is better under the real rule. */
+function rsCompareLevel(left: TurnPlan, right: TurnPlan, level: number): number {
+  if (level === 6) {
+    for (let index = 0; index < left.outcomes.length; index += 1) {
+      if (left.outcomes[index] !== right.outcomes[index]) {
+        return left.outcomes[index] === true ? 1 : -1;
+      }
+    }
+    return 0;
+  }
+  const diff = rsPlanValue(left, level) - rsPlanValue(right, level);
+  return level === 5 ? -diff : diff;
+}
+function rsShadowBetterPlan(left: TurnPlan, right: TurnPlan, reversedLevel: number): boolean {
+  for (let level = 1; level <= reversedLevel; level += 1) {
+    const cmp = rsCompareLevel(left, right, level) * (level === reversedLevel ? -1 : 1);
+    if (cmp !== 0) {
+      return cmp > 0;
+    }
+  }
+  return false;
+}
+function rsShadowPlan(
+  level: number,
+  spells: readonly SpellCard[],
+  available: readonly PaymentSource[],
+  attachment: readonly PaymentSource[]
+): TurnPlan {
+  const previous = rsShadowLevel;
+  rsShadowLevel = level;
+  try {
+    return planTurn(spells, available, attachment);
+  } finally {
+    rsShadowLevel = previous;
+  }
+}
+function rsCastMultiset(plan: TurnPlan): string {
+  return plan.casts.map((cast) => rsBaseId(cast.spell.id)).sort().join("|");
+}
+
+/**
+ * For one real planTurn decision that casts something: at which levels of the ordered rule does an alternative plan,
+ * tied with the real plan on every earlier level, do strictly worse? Level 1 (mana spent) is not probed: the empty plan
+ * is always worse. Level 6 (hand order) is probed on a copy-grouped spell order and counts only a different multiset of
+ * cards (casting a different copy of the same card is not a choice).
+ */
+function rsRecordSpellDecision(
+  spells: readonly SpellCard[],
+  available: readonly PaymentSource[],
+  attachment: readonly PaymentSource[],
+  real: TurnPlan,
+  turn: number
+): void {
+  if (rsGet() === undefined || turn > RS_HORIZON || real.casts.length === 0) {
+    return;
+  }
+  rsInc("spell.decisions");
+  rsTurnFlags.castDecision = true;
+  const bites: number[] = [];
+  for (let level = 2; level <= 5; level += 1) {
+    const worse = rsShadowPlan(level, spells, available, attachment);
+    let prefixEqual = true;
+    for (let earlier = 1; earlier < level; earlier += 1) {
+      if (rsPlanValue(worse, earlier) !== rsPlanValue(real, earlier)) prefixEqual = false;
+    }
+    if (!prefixEqual) {
+      rsInc("spell.anomalyPrefixMismatch");
+    } else if (rsPlanValue(worse, level) !== rsPlanValue(real, level)) {
+      bites.push(level);
+      rsInc(`spell.bite.L${level}`);
+    }
+  }
+  // Level 6 on a copy-grouped order: earliest-first plan against latest-first plan, same earlier levels.
+  const grouped = [...spells].sort((a, b) => (rsBaseId(a.id) < rsBaseId(b.id) ? -1 : rsBaseId(a.id) > rsBaseId(b.id) ? 1 : 0));
+  const earliest = rsShadowPlan(7, grouped, available, attachment); // level 7: levels 1..6 normal, nothing reversed
+  const latest = rsShadowPlan(6, grouped, available, attachment);
+  let sameTuple = true;
+  for (let earlier = 1; earlier <= 5; earlier += 1) {
+    if (rsPlanValue(earliest, earlier) !== rsPlanValue(latest, earlier)) sameTuple = false;
+  }
+  if (!sameTuple) {
+    rsInc("spell.anomalyPrefixMismatch");
+  } else if (rsCastMultiset(earliest) !== rsCastMultiset(latest)) {
+    bites.push(6);
+    rsInc("spell.bite.L6");
+  }
+  if (bites.length > 0) {
+    rsInc("spell.decisionsWithTieBreak");
+    rsInc(`spell.firstBite.L${bites[0]}`);
+    if (!rsTurnFlags.bite) {
+      rsTurnFlags.bite = true;
+      rsTurnFlags.firstBite = bites[0]!;
+    }
+  }
+}
