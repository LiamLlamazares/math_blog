% manacards.sty: simplified cards (plain / art switch), mini chips, 8pt mana pips.
% Art mode is switched on from the command line:
%   pdflatex -jobname=fig_x_art '\def\CARDART{1}\input{fig_x}'
\ProvidesPackage{manacards}
\RequirePackage{graphicx}
\RequirePackage{textcomp}
\RequirePackage{manafig}
\usetikzlibrary{decorations.pathreplacing}
\newif\ifcardart
\ifdefined\CARDART\cardarttrue\fi
% plain sans for chart and card text; the hand-lettered \annot keeps Comic Neue. Define \COMICSANS before the class to keep Comic Neue everywhere.
\ifdefined\COMICSANS\else\renewcommand{\sfdefault}{qhv}\fi
\lefthyphenmin=100 \righthyphenmin=100 % no hyphenation in figure text
\definecolor{newc}{HTML}{E3A008}   % outline for "new this turn"

